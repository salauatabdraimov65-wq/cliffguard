# Copy to .env.local (never commit real keys). Set the same vars in Vercel → Project → Settings → Environment Variables.
# Stripe TEST mode secret key (Dashboard → Developers → API keys, "Test mode" on). Live keys are rejected.
STRIPE_SECRET_KEY=sk_test_replace_me
# Optional: public base URL for Stripe redirects (defaults to the request origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
